{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": { "lib/*": ["./lib/*"], "tests/*": ["./tests/*"] }
  },
  "include": ["lib", "pages", "tests", "vite.config.ts"]
}
